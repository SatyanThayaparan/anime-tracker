{
  "manifest_version": 3,
  "name": "Anime Tracker",
  "version": "1.5.2",
  "description": "Track watching time on Netflix, YouTube, and Disney+ with local daily, weekly, and monthly stats.",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.disneyplus.com/*",
    "https://graphql.anilist.co/*",
    "https://s4.anilist.co/*",
    "https://img.anili.st/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.disneyplus.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "utils/shows.js",
        "utils/storage.js",
        "utils/normalize.js",
        "utils/categories.js"
      ],
      "matches": [
        "*://*.netflix.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.disneyplus.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Anime Tracker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https://s4.anilist.co https://img.anili.st https:;"
  }
}
