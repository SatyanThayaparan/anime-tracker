{
  "manifest_version": 3,
  "name": "Shiori",
  "version": "1.13.0",
  "description": "Shiori (栞) — bookmark your anime watching on Netflix, Disney+, Crunchyroll, Prime Video, HIDIVE, and Hulu.",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.disneyplus.com/*",
    "*://*.crunchyroll.com/*",
    "*://*.primevideo.com/*",
    "*://*.amazon.com/gp/video/*",
    "*://*.amazon.ca/gp/video/*",
    "*://*.amazon.co.uk/gp/video/*",
    "*://*.amazon.de/gp/video/*",
    "*://*.amazon.co.jp/gp/video/*",
    "*://*.amazon.com.au/gp/video/*",
    "*://*.amazon.in/gp/video/*",
    "*://*.hidive.com/*",
    "*://*.hulu.com/*",
    "https://graphql.anilist.co/*",
    "https://s4.anilist.co/*",
    "https://img.anili.st/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/gp/video/*",
        "*://*.amazon.ca/gp/video/*",
        "*://*.amazon.co.uk/gp/video/*",
        "*://*.amazon.de/gp/video/*",
        "*://*.amazon.co.jp/gp/video/*",
        "*://*.amazon.com.au/gp/video/*",
        "*://*.amazon.in/gp/video/*",
        "*://*.hidive.com/*",
        "*://*.hulu.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "utils/shows.js",
        "utils/storage.js",
        "utils/normalize.js",
        "utils/categories.js"
      ],
      "matches": [
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.com.au/*",
        "*://*.amazon.in/*",
        "*://*.hidive.com/*",
        "*://*.hulu.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Shiori"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
